{
  "name": "memorylens",
  "version": "2.1.3",
  "description": "On-demand .NET memory profiling with concrete code fix suggestions. Requires the .NET 10 SDK; the server is fetched and run on demand via dnx.",
  "author": {
    "name": "Marcel Roozekrans",
    "url": "https://github.com/MarcelRoozekrans"
  },
  "homepage": "https://github.com/MarcelRoozekrans/memorylens-mcp",
  "repository": "https://github.com/MarcelRoozekrans/memorylens-mcp",
  "license": "MIT",
  "keywords": [
    "memory",
    "profiling",
    "eventpipe",
    "mcp",
    "dotnet",
    "leak-detection"
  ],
  "mcpServers": {
    "memorylens": {
      "command": "dnx",
      "args": [
        "--yes",
        "--version",
        "2.1.3",
        "MemoryLens.Mcp"
      ],
      "transport": "stdio"
    }
  }
}
